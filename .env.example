# Example env file (copy to .env.local and fill values)
VITE_API_URL_DEV=http://localhost:5000/api/v1
VITE_API_URL_PROD=https://your-production-api.example.com/api/v1

VITE_ORS_API_KEY=

# Optional: default is true in dev, false in production
VITE_ENABLE_DEMO_LOGIN=true

VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_DRIVER_EMAIL=
VITE_DEMO_DRIVER_PASSWORD=
VITE_DEMO_RIDER_EMAIL=
VITE_DEMO_RIDER_PASSWORD=
