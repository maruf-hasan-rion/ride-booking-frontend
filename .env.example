# Example env file (copy to .env.local and fill values)
VITE_API_URL_DEV=http://localhost:5000/api/v1
VITE_API_URL_PROD=https://your-production-api.example.com/api/v1

# Optional: default is true in dev, false in production.
# Set this explicitly ("true") when a production build should show demo login
# (portfolio/public demo). Demo credentials must exist in the database —
# create them with the backend's `npm run seed`.
VITE_ENABLE_DEMO_LOGIN=true

# Public demo credentials: these are intentionally NOT secret. They must match
# the accounts created by the backend seed (backend .env SEED_PASSWORD /
# SEED_ADMIN_PASSWORD).
VITE_DEMO_ADMIN_EMAIL=admin@seed.gomove.app
VITE_DEMO_ADMIN_PASSWORD=Seed!Ride123
VITE_DEMO_DRIVER_EMAIL=driver@seed.gomove.app
VITE_DEMO_DRIVER_PASSWORD=Seed!Ride123
VITE_DEMO_RIDER_EMAIL=rider@seed.gomove.app
VITE_DEMO_RIDER_PASSWORD=Seed!Ride123
